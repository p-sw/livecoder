{
  "name": "livecoder",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first filesystem code workspace with a Pi ACP agent.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun --cwd apps/api --watch src/main.ts",
    "dev:web": "bun --cwd apps/web dev",
    "build": "bun --cwd apps/web build",
    "start": "bun --cwd apps/api src/main.ts",
    "test": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
