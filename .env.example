PORT=3001
# Optional: which adapter id the API uses by default. Built-in: pi, oh-my-pi.
# PI_ADAPTER_DEFAULT=pi
#
# Override or add an adapter. Format: PI_ADAPTER_<ID> (+ optional _ARGS).
# Example: pin oh-my-pi to a custom binary path with extra flags.
# PI_ADAPTER_OH_MY_PI=/usr/local/bin/omp
# PI_ADAPTER_OH_MY_PI_ARGS=["acp","--flag"]
#
# Legacy single-adapter override (still honored when set, takes precedence
# over the registry).
# PI_ACP_COMMAND=pi-acp
# PI_ACP_ARGS=[]

# Web Push contact URI (mailto: or https:). Apple rejects @localhost.
# VAPID_SUBJECT=mailto:you@example.com
